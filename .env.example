# Copy to .env and fill with real values. Never commit .env.
DATABASE_URL=postgresql+psycopg://swasthya:swasthya@localhost:5432/swasthya
HAPI_FHIR_BASE_URL=http://localhost:8080/fhir
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-2.0-flash
SARVAM_API_KEY=
SARVAM_TTS_VOICE=meera
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMARTTHINGS_TOKEN=
VOICE_CLONE_PROVIDER=none
KEYCLOAK_BASE_URL=http://localhost:8081
INTERPRETER_CONFIDENCE_HIGH=0.75
INTERPRETER_CONFIDENCE_LOW=0.35
DOCTOR_APPROVAL_TIMEOUT_SECONDS=900
DOCTOR_APPROVAL_TIMEOUT_SECONDS_TIME_CRITICAL=180

# Dev/offline escape hatch for the API's auth middleware (docs/api_contract.md).
# Default is auth ENABLED -- only set this to true for local work without
# a running Keycloak. Never set this in anything beyond a laptop demo.
AUTH_DISABLED=false

# Comma-separated list of origins the API's CORS middleware allows
# (src/swasthya/api/app.py). The dashboard's dev/local origin by default.
CORS_ORIGINS=http://localhost:3000

# --- docker/docker-compose.yml additions below ---

# Postgres (the `postgres` service). These are also baked into
# DATABASE_URL above when running outside Docker -- keep them in sync.
POSTGRES_USER=swasthya
POSTGRES_PASSWORD=swasthya
POSTGRES_DB=swasthya

# Keycloak admin console login (the `keycloak` service, dev mode only).
# admin/admin is fine for a laptop demo and MUST be changed for anything
# that isn't a laptop demo.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Dashboard (Next.js) -- browser-facing URLs. These are fetched directly
# by the user's browser, so they must use the host-mapped port/hostname,
# never a Docker Compose service name (that only resolves inside the
# compose network, not on the host machine or in a browser).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXTAUTH_URL=http://localhost:3000
# Generate a real value with `openssl rand -base64 32` (or
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`).
# The placeholder below is ONLY for local dev -- replace it before
# running this anywhere but a laptop; NextAuth uses it to sign/encrypt
# session cookies and JWTs.
NEXTAUTH_SECRET=replace-this-with-a-real-random-secret-before-anything-but-local-dev

# LiveKit (voice agent) -- NOT wired into docker-compose.yml yet. The
# voice-agent service is intentionally excluded from the compose stack
# because this environment has no live LiveKit room credentials. Fill
# these in and add a `voice-agent` service (entrypoint:
# `python -m swasthya.voice.entrypoint start`) once you have a LiveKit
# project. Left unset here on purpose.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
