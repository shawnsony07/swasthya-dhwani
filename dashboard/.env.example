# Keycloak OIDC issuer (realm "swasthya"). The dashboard's NextAuth config
# derives the authorization/token/jwks endpoints from this via OIDC discovery.
KEYCLOAK_BASE_URL=http://localhost:8081

# Public client id registered in Keycloak for this dashboard. Public client:
# no client secret, so none is read here.
KEYCLOAK_CLIENT_ID=swasthya-dashboard

# Base URL of the FastAPI backend (docs/api_contract.md). Exposed to the
# browser (NEXT_PUBLIC_) because the SSE client (EventSource) connects to it
# directly from client-side code.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# NextAuth / Auth.js v5 requires a secret to sign/encrypt session cookies and
# JWTs. Generate one with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=changeme-generate-a-real-secret

# Canonical origin of the dashboard itself, used by NextAuth for callback
# URLs. Must match a redirect URI registered on the Keycloak client.
AUTH_URL=http://localhost:3000
